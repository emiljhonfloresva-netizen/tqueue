// Select the first four compatible players without splitting a pair.
function pickQueue() {
  const selected=[];
  let count=0;
  for(const entry of state.queue) {
    if(count+entry.names.length<=4) {
      selected.push(entry);
      count+=entry.names.length;
    }
    if(count===4) return selected;
  }
  return [];
}

function splitSides(entries) {
  const sides=[[],[]];
  for(const e of entries.filter(e=>e.names.length===2))
    sides[sides[0].length===0?0:1].push(...e.names);
  for(const e of entries.filter(e=>e.names.length===1))
    sides[sides[0].length<2?0:1].push(...e.names);
  return sides;
}

