<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Court Club — Pickleball Manager</title>
<style>
:root{--ink:#18392e;--muted:#718078;--green:#164c38;--lime:#d6f782;--bg:#f5f7f2;--line:#e3e8df;--red:#b13e3e}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer;border:1px solid var(--line);background:white;border-radius:9px;padding:9px 14px;color:var(--ink);font-weight:650}
button:hover{filter:brightness(.96)}
button:disabled{opacity:.45;cursor:not-allowed}
button,input,select,textarea{outline-offset:4px}
button:focus-visible{outline:3px solid #83ad54}
.primary{background:var(--green);border-color:var(--green);color:white}
.lime{background:var(--lime);border-color:var(--lime)}
.ghost{background:transparent}
.small{font-size:12px;padding:5px 9px}
.danger{color:var(--red)}
.full{width:100%}
.app{display:grid;grid-template-columns:238px 1fr;min-height:100vh}
.sidebar{background:#123c2e;color:#d5e6dc;padding:30px 20px;display:flex;flex-direction:column;gap:26px}
.brand{font-size:23px;font-weight:850;letter-spacing:-1px;color:white;display:flex;gap:10px;align-items:center}
.brandmark{background:var(--lime);color:var(--green);border-radius:50%;width:34px;height:34px;display:grid;place-items:center;font-size:22px;transform:rotate(-15deg)}
.eyebrow{font-size:10px;letter-spacing:1.8px;font-weight:750;text-transform:uppercase}
.sidebar .eyebrow{color:#8cab9c;padding:0 12px}
.nav{display:grid;gap:7px}
.nav button{border:0;background:transparent;color:#b8cfc1;text-align:left;padding:13px 12px;display:flex;align-items:center;gap:12px}
.nav button.active{background:var(--lime);color:#18392e}
.nav .icon{font-size:18px;width:22px}
.clubnote{margin-top:auto;border:1px solid #38604e;padding:17px;border-radius:12px;font-size:12px}
.clubnote strong{display:block;color:white;margin:4px 0 9px}
.sidebottom{font-size:11px;color:#a1bcac}
.sidebottom button{color:#bfd5c7;border-color:#38604e;background:transparent;margin-top:10px;width:100%;font-size:11px}
.main{min-width:0}
.topbar{height:79px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 36px;background:white;gap:12px}
.breadcrumb{font-size:12px;color:var(--muted)}
.breadcrumb b{color:var(--ink)}
.topright{display:flex;align-items:center;gap:12px;font-size:12px}
.dot{width:7px;height:7px;border-radius:50%;background:#4c9b69;display:inline-block}
.avatar{background:#eef2e9;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;font-size:11px;font-weight:800}
.content{padding:30px 36px 40px;max-width:1500px;margin:auto}
.heading{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:22px}
h1{font-size:29px;letter-spacing:-1px;margin:3px 0 4px;line-height:1.2}
h2{font-size:17px;margin:0}
h3{font-size:15px;margin:0}
.muted{color:var(--muted)}
p{margin:6px 0}
.heading p{font-size:13px}
.actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.hero{position:relative;overflow:hidden;border-radius:16px;background:var(--green);padding:28px 30px;color:white;display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:22px}
.hero p{color:#c3d7ca;max-width:440px}
.hero h2{font-size:26px;letter-spacing:-.7px;margin:9px 0}
.hero .eyebrow{color:var(--lime)}
.court-art{width:190px;height:108px;border:2px solid #82b28b;transform:rotate(-13deg);position:relative;margin-right:35px;flex-shrink:0;opacity:.8;background:linear-gradient(90deg,transparent 49%,#82b28b 49%,#82b28b 50%,transparent 50%),linear-gradient(0deg,transparent 49%,#82b28b 49%,#82b28b 51%,transparent 51%)}
.court-art:before{content:"";position:absolute;left:33%;right:33%;top:0;bottom:0;border-left:2px solid #82b28b;border-right:2px solid #82b28b;background:#397658}
.court-art:after{content:"";position:absolute;width:21px;height:21px;background:var(--lime);border-radius:50%;top:16px;right:19px;box-shadow:0 3px 8px #102e26}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:25px}
.stat{background:white;border:1px solid var(--line);padding:18px 20px;border-radius:12px}
.stat .label{font-size:12px;color:var(--muted)}
.stat strong{font-size:29px;display:block;letter-spacing:-1px;margin:5px 0}
.stat small{font-size:11px;color:var(--muted)}
.grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:20px}
.panel{background:white;border:1px solid var(--line);border-radius:13px;overflow:hidden}
.panelhead{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px;border-bottom:1px solid var(--line)}
.panelbody{padding:20px}
.scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;white-space:nowrap;text-align:left}
th{font-size:10px;letter-spacing:.7px;color:var(--muted);background:#fafbf8;padding:12px;text-transform:uppercase}
td{padding:15px 12px;border-top:1px solid #f0f2ec;font-size:12px}
td:first-child,th:first-child{padding-left:20px}
.leading{background:#f0f7df}
.teamcell{display:flex;align-items:center;gap:10px;font-weight:700}
.crest{width:33px;height:33px;display:inline-grid;place-items:center;background:#edf2e6;border:1px solid #dce5d1;border-radius:10px;font-size:11px;font-weight:800;flex-shrink:0}
.badge{display:inline-flex;align-items:center;gap:5px;border-radius:5px;padding:3px 6px;font-size:9px;text-transform:uppercase;letter-spacing:.5px;font-weight:800;background:#edf3e8;color:#476343}
.badge.tie{background:#fff1cd;color:#8a641c}
.badge.lock{background:#e6f2e8;color:#2d754a}
.badge.live{background:var(--lime);color:var(--ink)}
.footnote{font-size:11px;color:var(--muted);padding:14px 20px;border-top:1px solid var(--line)}
.fixture{padding:18px 20px;border-bottom:1px solid var(--line)}
.fixture:last-child{border-bottom:0}
.fixture .vs{display:flex;justify-content:space-between;align-items:center;margin:10px 0;font-size:13px;font-weight:700;gap:8px}
.fixture .vs span:nth-child(2){font-size:10px;color:var(--muted);font-weight:400}
.fixture small{color:var(--muted)}
.empty{padding:32px;text-align:center;color:var(--muted);font-size:13px}
.sectiongap{margin-top:22px}
.teamgrid,.courtgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.teamtop{padding:20px;display:flex;align-items:center;justify-content:space-between;gap:10px}
.teamtop .crest{width:43px;height:43px}
.players{padding:0 20px}
.player{padding:11px 0;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px}
.player span{overflow-wrap:anywhere}
.player.bench{color:var(--muted)}
.teamfooter{padding:16px 20px;border-top:1px solid var(--line);margin-top:12px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.notice{padding:13px 16px;border-radius:9px;background:#edf3e7;font-size:12px;color:#546b50;margin-bottom:20px}
.scheduletools{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px;margin-bottom:22px}
.day{border:1px solid var(--line);background:white;border-radius:10px;min-height:125px;padding:10px}
.day.today{border-color:var(--green)}
.dayname{color:var(--muted);font-size:10px;text-transform:uppercase}
.daynum{font-size:19px;font-weight:700;margin-bottom:6px}
.calitem{display:block;width:100%;text-align:left;background:#edf4e6;border:0;border-left:3px solid #729351;border-radius:4px;font-size:10px;padding:5px;margin-top:5px;font-weight:500}
.calitem.done{opacity:.65;border-color:#b0b9a8}
.fixtureline{padding:17px 20px;border-top:1px solid var(--line);display:grid;grid-template-columns:1.1fr 1.6fr auto;gap:18px;align-items:center}
.fixtureline:first-child{border-top:0}
.inlineedit{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.inlineedit input,.inlineedit select{padding:6px;min-width:0;width:auto;font-size:11px}
.scores{font-size:12px;color:var(--muted);margin-top:5px}
.queuegrid{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(0,1.6fr);gap:22px}
.courtgrid{grid-template-columns:repeat(2,minmax(0,1fr))}
.court{padding:20px;background:white;border:1px solid var(--line);border-radius:12px}
.courttop{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.courtfloor{border:2px solid #c9d7c4;min-height:154px;border-radius:5px;background:linear-gradient(0deg,transparent 49%,#c9d7c4 49%,#c9d7c4 51%,transparent 51%),#f2f6ed;display:flex;flex-direction:column;justify-content:space-around;text-align:center;padding:10px;gap:14px;margin-bottom:15px}
.courtfloor div{display:flex;gap:7px;justify-content:center;flex-wrap:wrap}
.pill{background:white;padding:4px 9px;border:1px solid #dce5d5;border-radius:6px;font-size:12px;overflow-wrap:anywhere;max-width:100%}
.queueitem{padding:15px 18px;display:flex;gap:13px;align-items:center;border-bottom:1px solid var(--line)}
.queueitem:last-child{border-bottom:0}
.position{font-weight:800;color:#a1ae99;font-size:17px}
.queueitem .names{flex:1;min-width:0;overflow-wrap:anywhere}
.queueitem small{display:block;color:var(--muted);font-size:10px}
.toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:#173d2f;color:white;padding:13px 22px;border-radius:10px;box-shadow:0 6px 25px #0002;z-index:20;max-width:90vw;font-size:13px}
.toast[hidden]{display:none}
dialog{border:0;border-radius:16px;padding:0;width:min(540px,calc(100vw - 30px));max-height:90vh;color:var(--ink);box-shadow:0 20px 90px #0003}
dialog::backdrop{background:#102b255c;backdrop-filter:blur(3px)}
.modalhead{padding:22px 24px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
.modalbody{padding:22px 24px}
label{display:block;font-size:12px;font-weight:650;margin-bottom:14px}
label small{display:block;font-weight:400;color:var(--muted);margin:4px 0}
input,select,textarea{display:block;width:100%;padding:10px 11px;border:1px solid #d8dfd2;border-radius:7px;color:var(--ink);background:white;margin-top:6px}
textarea{min-height:90px;resize:vertical}
.twocol{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.formactions{display:flex;justify-content:flex-end;gap:9px;margin-top:20px}
input[type=checkbox]{display:inline;width:auto;margin:0 7px 0 0}
.error{font-size:12px;color:var(--red);background:#fff3ef;padding:10px;border-radius:6px;margin-top:10px}
.error:empty{display:none}
.gamerow{display:grid;grid-template-columns:65px 1fr 20px 1fr;gap:9px;align-items:center;margin:10px 0;font-size:12px}
.gamerow input{margin:0}
.subtitle{font-size:12px;color:var(--muted)}
.longname{overflow-wrap:anywhere}
.legend{font-size:11px;color:var(--muted);margin-top:10px}
.savewarning{background:#fff1cd;padding:10px;text-align:center;color:#7b5919;font-size:12px}
@media(min-width:1600px){.content{padding-top:38px}}
@media(max-width:1150px){
.app{grid-template-columns:205px 1fr}
.content{padding:25px 22px}
.topbar{padding:0 22px}
.grid{grid-template-columns:1fr}
.grid>aside{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.teamgrid{grid-template-columns:repeat(2,minmax(0,1fr))}
.fixtureline{grid-template-columns:1fr}
.queuegrid{grid-template-columns:1fr}
.courtgrid{grid-template-columns:repeat(3,minmax(0,1fr))}
.week{overflow-x:auto;grid-template-columns:repeat(7,minmax(110px,1fr))}
.court-art{margin-right:0}
}
@media(max-width:760px){
.app{display:block}
.sidebar{padding:14px 16px;gap:15px}
.brand{font-size:20px}
.sidebar>.eyebrow,.clubnote,.sidebottom{display:none}
.nav{display:flex;overflow-x:auto;gap:5px}
.nav button{white-space:nowrap;padding:9px 11px;font-size:11px}
.nav .icon{display:none}
.topbar{height:49px;padding:0 18px}
.topright .avatar,.topright #saved{display:none}
.content{padding:24px 16px}
.heading{align-items:flex-start;flex-direction:column}
h1{font-size:27px}
.hero{padding:22px}
.hero h2{font-size:23px}
.stats{grid-template-columns:repeat(2,1fr);gap:10px}
.stat{padding:15px}
.grid>aside{display:block}
.grid>aside>.panel{margin-bottom:18px}
.teamgrid,.courtgrid{grid-template-columns:1fr}
.panelhead{padding:16px}
.fixtureline{padding:16px}
.topright{font-size:10px}
.inlineedit input{max-width:155px}
.hero p{font-size:12px}
.hero .court-art{display:none}
.twocol{gap:9px}
.teamtop{padding:16px}
.panelhead .actions{justify-content:flex-end}
}
</style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><span class="brandmark">◉</span>court club<span style="color:#d6f782">.</span></div>
    <div class="eyebrow">Your club, in play</div>
    <nav class="nav" aria-label="Main navigation">
      <button data-tab="dashboard" class="active"><span class="icon">▦</span>Dashboard / Standings</button>
      <button data-tab="matches"><span class="icon">▤</span>Matches & Calendar</button>
      <button data-tab="teams"><span class="icon">♧</span>Team Roster</button>
      <button data-tab="queue"><span class="icon">▥</span>Open Play Queue</button>
    </nav>
    <div class="clubnote">
      <span class="eyebrow" style="padding:0">A little less admin</span>
      <strong>A lot more court time.</strong>
      Set your partners. Play your game.<br>We’ll keep the score.
    </div>
    <div class="sidebottom">COURT CLUB · LOCAL EDITION
      <button data-action="reset">↻ Reset Demo Data</button>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="breadcrumb">Club workspace <span style="padding:0 7px">/</span> <b id="crumb">Overview</b></div>
      <div class="topright">
        <span id="saved"><i class="dot"></i> Saved on this browser</span>
        <span class="avatar">CC</span>
        <button class="small" data-action="export" title="Download all club data as JSON">Backup</button>
        <button class="small" data-action="reset" title="Restore sample teams, results and queue">Reset demo</button>
      </div>
    </header>
    <div id="storage-warning"></div>
    <div id="view" class="content"></div>
  </main>
</div>

<dialog id="modal" aria-labelledby="modal-title">
  <div class="modalhead">
    <h2 id="modal-title"></h2>
    <button class="small ghost" type="button" data-action="close" aria-label="Close dialog">✕</button>
  </div>
  <div class="modalbody" id="modal-body"></div>
</dialog>
<div id="toast" class="toast" role="status" hidden></div>

<script>
'use strict';

const KEY = 'court-club-v1';
const $ = s => document.querySelector(s);
const esc = v => String(v ?? '').replace(/[&<>"']/g, c =>
  ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])
);
const uid = () => globalThis.crypto?.randomUUID?.() ||
  Date.now().toString(36) + Math.random().toString(36).slice(2);

const dateKey = d =>
  `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;

const today = () => dateKey(new Date());

const atDay = (offset, hour=18) => {
  const d = new Date();
  d.setDate(d.getDate()+offset);
  return dateKey(d)+'T'+String(hour).padStart(2,'0')+':00';
};

const courts = ['Court 1','Court 2','Court 3'];

function demo() {
  return {
    version:1,
    teams:[
      ['t1','Kitchen Kings',['Alex Morgan','Jamie Chen','Taylor Reed']],
      ['t2','Dink Dynasty',['Sam Rivera','Jordan Lee']],
      ['t3','Rally Rebels',['Casey Brooks','Riley Park']],
      ['t4','The Volley Llamas',['Drew Ellis','Quinn Patel']],
      ['t5','Net Ninjas',['Avery Scott','Blake Cruz']],
      ['t6','Baseline Bandits',['Cameron Wells','Skyler James']]
    ].map(([id,name,players]) => ({
      id,name,locked:true,
      players:players.map((name,i)=>({id:uid(),name,active:i<2}))
    })),
    matches:[
      {id:'m1',a:'t1',b:'t2',date:atDay(-3),court:'Court 1',target:11,best:3,games:[[11,7],[11,9]]},
      {id:'m2',a:'t3',b:'t4',date:atDay(-3,19),court:'Court 2',target:11,best:3,games:[[11,6],[8,11],[11,9]]},
      {id:'m3',a:'t1',b:'t5',date:atDay(-2),court:'Court 1',target:11,best:3,games:[[11,8],[11,6]]},
      {id:'m4',a:'t2',b:'t6',date:atDay(-2,19),court:'Court 2',target:11,best:3,games:[[11,7],[11,8]]},
      {id:'m5',a:'t3',b:'t6',date:atDay(-1),court:'Court 1',target:11,best:3,games:[[11,8],[11,9]]},
      {id:'m6',a:'t4',b:'t5',date:atDay(-1,19),court:'Court 2',target:11,best:3,games:[[11,9],[6,11],[11,8]]},
      {id:'m7',a:'t1',b:'t3',date:atDay(0),court:'Court 1',target:11,best:3,games:null},
      {id:'m8',a:'t2',b:'t4',date:atDay(1),court:'Court 2',target:15,best:1,games:null},
      {id:'m9',a:'t5',b:'t6',date:atDay(2),court:'Court 3',target:21,best:1,games:null}
    ],
    queue:[
      {id:uid(),names:['Morgan Bell','Charlie Kim']},
      {id:uid(),names:['Parker Lane']},
      {id:uid(),names:['Reese Young']},
      {id:uid(),names:['Robin Fox','Finley Gray']}
    ],
    live:{}
  };
}

let state;
let storageOK = true;
let tab = 'dashboard';
let weekOffset = 0;
let matchFilter = 'all';
let pendingMatch = null;

try {
  const raw = localStorage.getItem(KEY);
  state = raw ? JSON.parse(raw) : demo();
  if (
    state.version !== 1 ||
    !Array.isArray(state.teams) ||
    !Array.isArray(state.matches) ||
    !Array.isArray(state.queue) ||
    !state.live
  ) throw Error('Invalid saved data');
} catch {
  state = demo();
  storageOK = false;
}

const team = id => state.teams.find(t=>t.id===id);
const name = id => team(id)?.name || 'Unknown team';
const initials = s => s.split(/\s+/).slice(0,2).map(w=>w[0]||'').join('').toUpperCase();
const complete = m => Array.isArray(m.games) && m.games.length>0;

const winner = m => {
  let a=0,b=0;
  m.games.forEach(g=>g[0]>g[1]?a++:b++);
  return a>b?m.a:m.b;
};

// Compute rankings from match history, so editing/removing a result
// cannot leave stale totals behind.
function standings() {
  const rows = state.teams.map(t=>({
    id:t.id,name:t.name,mp:0,w:0,l:0,pf:0,pa:0,diff:0,h2h:0
  }));
  const map = new Map(rows.map(r=>[r.id,r]));

  state.matches.filter(complete).forEach(m=>{
    const a=map.get(m.a),b=map.get(m.b);
    if(!a||!b) return;
    a.mp++; b.mp++;
    m.games.forEach(([x,y])=>{
      a.pf+=x; a.pa+=y;
      b.pf+=y; b.pa+=x;
    });
    const win=winner(m);
    map.get(win).w++;
    map.get(win===m.a?m.b:m.a).l++;
  });

  rows.forEach(r=>r.diff=r.pf-r.pa);

  // Head-to-head mini-table only includes teams tied on wins and differential.
  const groups = new Map();
  rows.forEach(r=>{
    const key=r.w+','+r.diff;
    if(!groups.has(key)) groups.set(key,[]);
    groups.get(key).push(r);
  });
  groups.forEach(group=>{
    if(group.length<2) return;
    const ids=new Set(group.map(r=>r.id));
    state.matches
      .filter(m=>complete(m)&&ids.has(m.a)&&ids.has(m.b))
      .forEach(m=>map.get(winner(m)).h2h++);
  });

  rows.sort((a,b)=>
    b.w-a.w || b.diff-a.diff || b.h2h-a.h2h || a.name.localeCompare(b.name)
  );

  rows.forEach((r,i)=>{
    const same=x=>x.w===r.w&&x.diff===r.diff&&x.h2h===r.h2h;
    r.tie=rows.filter(same).length>1;
    r.rank=i&&same(rows[i-1])?rows[i-1].rank:i+1;
  });
  return rows;
}

let toastTimer;
function toast(message) {
  $('#toast').textContent=message;
  $('#toast').hidden=false;
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>$('#toast').hidden=true,3800);
}

function persist() {
  try {
    localStorage.setItem(KEY,JSON.stringify(state));
    storageOK=true;
  } catch {
    storageOK=false;
  }
  storageStatus();
}

function storageStatus() {
  $('#saved').innerHTML=storageOK
    ? '<i class="dot"></i> Saved on this browser'
    : 'Session only';
  $('#storage-warning').innerHTML=storageOK?'':`
    <div class="savewarning" role="alert">
      Browser storage is unavailable or saved data could not be loaded.
      Changes may not survive refresh. Enable local storage or download a backup.
    </div>`;
}

function commit(message) {
  persist();
  render();
