document.addEventListener('click',e=>{
  const b=e.target.closest('button');
  if(!b) return;

  if(b.dataset.tab) {
    tab=b.dataset.tab;
    render();
    return;
  }

  const id=b.dataset.id,action=b.dataset.action;
  const t=team(id),m=state.matches.find(x=>x.id===id);

  switch(action) {
    case 'close':
      closeModal();
      break;
    case 'go-queue':
      tab='queue'; render();
      break;
    case 'go-matches':
      tab='matches'; render();
      break;
    case 'add-team':
      rosterModal();
      break;
    case 'edit-team':
      if(t&&!t.locked) rosterModal(id);
      break;
    case 'lock':
      if(t) {
        t.locked=!t.locked;
        commit(t.locked?'Roster locked in.':'Roster unlocked.');
      }
      break;
    case 'toggle-player':
      if(t&&!t.locked) {
        const p=t.players.find(x=>x.id===b.dataset.player);
        if(p.active&&t.players.filter(x=>x.active).length===1) {
          toast('Keep at least one player active.');
          break;
        }
        p.active=!p.active;
        commit('Lineup updated.');
      }
      break;
    case 'schedule':
      matchModal();
      break;
    case 'new-score':
      matchModal(true);
      break;
    case 'score':
      if(m) scoreModal(m);
      break;
    case 'delete-match':
      if(m) confirmModal(
        'Remove this match?',
        'The fixture and any recorded scores will be removed. Standings will be recalculated.',
        'confirm-delete',id
      );
      break;
    case 'confirm-delete':
      state.matches=state.matches.filter(x=>x.id!==id);
      closeModal();
      commit('Match removed. Standings updated.');
      break;
    case 'prev-week':
      weekOffset--; render();
      break;
    case 'next-week':
      weekOffset++; render();
      break;
    case 'this-week':
      weekOffset=0; render();
      break;
    case 'join-queue':
      joinModal();
      break;
    case 'leave-queue':
      state.queue=state.queue.filter(x=>x.id!==id);
      commit('Paddle removed from the rack.');
      break;
    case 'start-court': {
      if(state.live[id]) break;
      const entries=pickQueue();
      if(!entries.length) {
        toast('Four compatible players are needed.');
        break;
      }
      const now=new Date();
      if(state.matches.some(x=>
        !complete(x)&&x.court===id&&new Date(x.date)<=now&&now-new Date(x.date)<3600000
      )) {
        toast('This court is reserved for a scheduled fixture. Reschedule it first.');
        break;
      }
      state.live[id]={entries,started:now.toISOString()};
      const ids=new Set(entries.map(x=>x.id));
      state.queue=state.queue.filter(x=>!ids.has(x.id));
      commit(`${id} is in play. Have a good game!`);
      break;
    }
    case 'finish-court':
      if(state.live[id]) {
        state.queue.push(...state.live[id].entries);
        delete state.live[id];
        commit('Game finished. Players rotated to the back of the rack.');
      }
      break;
    case 'reset':
      confirmModal(
        'Reset the club demo?',
        'Replace all teams, results, scheduled fixtures, queue entries and active courts with fresh sample data.',
        'confirm-reset'
      );
      break;
    case 'confirm-reset':
      state=demo();
      closeModal();
      commit('Fresh demo loaded.');
      break;
    case 'export':
      exportData();
      break;
  }
});

document.addEventListener('change',e=>{
  if(e.target.id==='match-filter') {
    matchFilter=e.target.value;
    render();
  }
  if(e.target.id==='entry-type') {
    const pair=e.target.value==='pair';
    $('#partner-label').hidden=!pair;
    $('[name=two]').required=pair;
  }
});

document.addEventListener('submit',e=>{
  e.preventDefault();
  const f=e.target,d=new FormData(f);

  if(f.matches('[data-reschedule]')) {
    const m=state.matches.find(x=>x.id===f.dataset.reschedule);
    const candidate={...m,date:d.get('date'),court:d.get('court')};
    if(!Number.isFinite(new Date(candidate.date).getTime()))
      return toast('Choose a valid date and time.');
    if(conflict(candidate,m.id))
      return toast('That court has another fixture within 60 minutes.');
    Object.assign(m,candidate);
    commit('Fixture rescheduled.');
    return;
  }

  if(f.id==='team-form') {
    const teamName=d.get('name').trim();
    const lines=d.get('players').split('\n').map(x=>x.trim()).filter(Boolean);
    const players=lines.map(s=>({
      id:uid(),name:s.replace(/^\*\s*/, '').trim(),active:!s.startsWith('*')
    }));

    if(!teamName) return error('Enter a team name.');
    if(state.teams.some(t=>
      t.id!==f.dataset.id&&t.name.toLowerCase()===teamName.toLowerCase()
    )) return error('A team with this name already exists.');

    if(!players.length||players.some(p=>!p.name||p.name.length>60))
      return error('Enter player names of 1–60 characters.');
    if(!players.some(p=>p.active))
      return error('Keep at least one player active.');

    const names=players.map(p=>p.name.toLocaleLowerCase());
    if(new Set(names).size!==names.length)
      return error('Each player must appear only once.');

    const occupied=state.teams.filter(t=>t.id!==f.dataset.id)
      .flatMap(t=>t.players.map(p=>p.name.toLocaleLowerCase()));
    if(names.some(n=>occupied.includes(n)))
      return error('A player is already on another team. Use unique full names.');

    const value={name:teamName,players,locked:d.has('locked')};
    const t=team(f.dataset.id);
    if(t&&t.locked) return error('Unlock this roster before editing.');
    if(t) Object.assign(t,value);
    else state.teams.push({id:uid(),...value});

    closeModal();
    commit('Team roster saved.');
    return;
  }

  if(f.id==='schedule-form') {
    const m={
      id:uid(),a:d.get('a'),b:d.get('b'),date:d.get('date'),
      court:d.get('court'),target:Number(d.get('target')),
      best:Number(d.get('best')),games:null
    };
    if(m.a===m.b) return error('Choose two different teams.');
    if(!Number.isFinite(new Date(m.date).getTime()))
      return error('Choose a valid date and time.');
    if(conflict(m))
      return error('This court is reserved within 60 minutes of that time.');

    closeModal();
    if(f.dataset.scoring==='true') scoreModal(m,true);
    else {
      state.matches.push(m);
      commit('Match scheduled.');
    }
    return;
  }

  if(f.id==='score-form') {
    const m=f.dataset.new==='true'
      ? pendingMatch
      : state.matches.find(x=>x.id===f.dataset.id);
    if(!m) return error('This fixture no longer exists.');

    const games=[];
    let blank=false;
    for(let i=0;i<m.best;i++) {
      const a=d.get('a'+i),b=d.get('b'+i);
      if(a===''&&b==='') {
        blank=true;
        continue;
      }
      if(blank) return error('Enter games in order without gaps.');
      if(a===''||b==='') return error(`Enter both scores for game ${i+1}.`);
      games.push([Number(a),Number(b)]);
    }

    const problem=validateGames(games,m.target,m.best);
    if(problem) return error(problem);

    m.games=games;
    if(f.dataset.new==='true') state.matches.push(m);
    pendingMatch=null;
    closeModal();
    commit('Result recorded. Standings are up to date.');
    return;
  }

  if(f.id==='queue-form') {
    const names=[d.get('one').trim()];
    if(d.get('type')==='pair') names.push(d.get('two').trim());
    const normalized=names.map(n=>n.toLocaleLowerCase());

    if(names.some(n=>!n)) return error('Enter a name for each player.');
    if(new Set(normalized).size!==names.length)
      return error('Partners must be different players.');

    const busy=[
      ...state.queue,
      ...Object.values(state.live).flatMap(x=>x.entries)
    ].flatMap(x=>x.names.map(n=>n.toLocaleLowerCase()));

    if(normalized.some(n=>busy.includes(n)))
      return error('A player is already waiting or playing on a court.');

    state.queue.push({id:uid(),names});
    closeModal();
    commit('Paddles added. See you on court!');
  }
});

$('#modal').addEventListener('click',e=>{
  if(e.target===$('#modal')) {
    const r=e.target.getBoundingClientRect();
    if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)
      closeModal();
  }
});

window.addEventListener('storage',e=>{
  if(e.key===KEY&&e.newValue)
    toast('Club data changed in another tab. Reload to use the latest data before editing.');
});

render();
if(storageOK) persist();
</script>
</body>
</html>
