function validateGames(games,target,best) {
  if(!games.length) return 'Enter at least one game.';
  const wins=[0,0],need=Math.floor(best/2)+1;
  if(games.length>best) return 'Too many games for this format.';

  for(let i=0;i<games.length;i++) {
    if(Math.max(...wins)>=need)
      return 'Remove games played after the match was clinched.';

    const [a,b]=games[i];
    if(!Number.isSafeInteger(a)||!Number.isSafeInteger(b)||a<0||b<0)
      return `Game ${i+1}: use non-negative whole numbers.`;

    const hi=Math.max(a,b),lo=Math.min(a,b);
    if(hi<target||hi-lo<2||(hi>target&&hi-lo!==2))
      return `Game ${i+1}: play to ${target}, win by 2. Overtime must end at a 2-point margin.`;

    wins[a>b?0:1]++;
  }
  return Math.max(...wins)!==need
    ? `The match is incomplete. One team needs ${need} game win${need===1?'':'s'}.`
    : '';
}

function conflict(m,exclude) {
  const start=new Date(m.date).getTime();
  return state.matches.some(x=>
    x.id!==exclude && x.court===m.court &&
    Math.abs(new Date(x.date).getTime()-start)<60*60*1000
  );
}

